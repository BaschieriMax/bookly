# Copy to .env (never commit real values).

# --- docker compose (local Postgres) ---
POSTGRES_USER=bookly
POSTGRES_PASSWORD=bookly_dev
POSTGRES_DB=bookly

# --- API (ASP.NET Core reads env vars with __ as section separator) ---
# Development values live in apps/api/src/Bookly.Api/appsettings.Development.json.
# Production (Render) needs (full guide: docs/deploy.md):
# Runtime role without DDL rights; migrations run from GitHub Actions with the owner role.
# ConnectionStrings__Default=Host=<ep-xxx>.eu-central-1.aws.neon.tech;Database=neondb;Username=bookly_app;Password=...;SSL Mode=VerifyFull;Channel Binding=Require;Maximum Pool Size=20;Connection Idle Lifetime=60
# App__PublicBaseUrl=https://bookly.example.com
# ReverseProxy__Enabled=true
#
# Email via Resend SMTP (DEC-022)
# Email__Host=smtp.resend.com
# Email__Port=465
# Email__Security=SslOnConnect
# Email__Username=resend
# Email__Password=<RESEND_API_KEY>
# Email__From=Bookly <no-reply@tuodominio.it>
#
# Jobs__Secret=<random 32+ chars>
#
# Error tracking (optional, DEC-031). Backend DSN at runtime; the frontend DSN is baked in at
# build time (Docker build arg VITE_SENTRY_DSN). Allow the ingest origin in the CSP:
# Sentry__Dsn=https://<key>@o<id>.ingest.de.sentry.io/<project>
# Sentry__Environment=production
# Security__ExtraConnectSources__0=https://o<id>.ingest.de.sentry.io
#
# First super-admin (DEC-028): register with this email, confirm it, then restart the service.
# Platform__SuperAdminEmails__0=tu@tuodominio.it
