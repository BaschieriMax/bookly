# Copy to .env (never commit real values).

# --- docker compose (local Postgres) ---
POSTGRES_USER=bookly
POSTGRES_PASSWORD=bookly_dev
POSTGRES_DB=bookly

# --- API (ASP.NET Core reads env vars with __ as section separator) ---
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=bookly;Username=bookly;Password=bookly_dev
# Email__Provider=Smtp            # Smtp (Mailpit) in development, Resend in production
# Email__SmtpHost=localhost
# Email__SmtpPort=1025
# Email__From=Bookly <no-reply@example.com>
# Resend__ApiKey=
# Jobs__Secret=
# App__PublicBaseUrl=http://localhost:5173
